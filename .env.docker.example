# REFERENCE ONLY. Merge needed values into the EXISTING server .env manually.
# Never copy over an existing .env or commit real credentials.
APP_NAME=Smart_Dryer_Hanjeli
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hanjeli-dryer.stas-rg.com
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dryer
DB_USERNAME=hanjeli_app
DB_PASSWORD=
# Separate, unique root password, used only by the MySQL container.
MYSQL_ROOT_PASSWORD=
DB_URL=
DB_SOCKET=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME=Smart_Dryer_Hanjeli
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=hanjeli-dryer.stas-rg.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=

# Use your external authenticated production broker, matching ESP32 settings.
MQTT_HOST=
MQTT_PORT=8883
MQTT_CLIENT_ID=smartdryer_hanjeli_production
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true
MQTT_CLEAN_SESSION=true
MQTT_TOPIC_TELEMETRY=hanjeli/greenhouse/telemetry
MQTT_TOPIC_ACTUATORS=hanjeli/greenhouse/actuators
MQTT_TOPIC_COMMAND=hanjeli/greenhouse/command
MQTT_TOPIC_CONTROL=hanjeli/greenhouse/control

# Keep this project name stable: it determines persistent volume names.
COMPOSE_PROJECT_NAME=hanjeli-dryer
APP_IMAGE=hanjeli-app
WEB_IMAGE=hanjeli-web
IMAGE_TAG=local
WEB_PORT=8088
